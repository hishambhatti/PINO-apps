    "# =============================================================================\n",
    "# PINO Wave 1D — Data Resolution Ablation (PDE @ 16× training res)\n",
    "# -----------------------------------------------------------------------------\n",
    "# Question: does zero-shot super-resolution up to 16× still hold when the\n",
    "# training data resolution becomes coarser or disappears entirely?\n",
    "#\n",
    "# Experiment:\n",
    "#   - Data training resolutions swept: [128, 64, 32, 16, 8, 4, None]\n",
    "#   - PDE loss resolution: always 16× the data training res for that run\n",
    "#     (None uses Nx_pde = 16 × 128 = 2048 as the PDE anchor)\n",
    "#   - Eval sweep per run: 1×, 2×, 4×, 8×, 16× the data training res\n",
    "#     → x-axis is always relative multiplier, making all runs comparable\n",
    "#   - Individual plot saved per run; combined plot at the end\n",
    "#   - Checkpoints named with both data res and PDE res (e.g. ablation-16x-data128.pt)\n",
    "#     to avoid collision with the prior fixed-PDE study\n",
    "# =============================================================================\n",
    "\n",
    "import os\n",
    "import numpy as np\n",
    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.cm as cm\n",
    "from tqdm import tqdm\n",
    "from train_utils.losses import LpLoss\n",
    "from train_utils.datasets import DataLoader1D\n",
    "from train_utils.utils import save_checkpoint, load_checkpoint\n",
    "\n",
    "# ── 0. Device ─────────────────────────────────────────────────────────────────\n",
    "\n",
    "EXPERIMENT_DEVICE = torch.device('cuda:0')\n",
    "torch.cuda.empty_cache()\n",
    "print(f\"Running on: {EXPERIMENT_DEVICE}\")\n",
    "print(f\"  Free VRAM: {torch.cuda.mem_get_info(EXPERIMENT_DEVICE)[0] / 1e9:.2f} GB\")\n",
    "\n",
    "\n",
    "# ── 1. Experiment config ──────────────────────────────────────────────────────\n",
    "\n",
    "sub_t_data = config['data']['sub_t']\n",
    "c          = config['data']['c']\n",
    "n_train    = config['data']['n_train']\n",
    "n_test     = config['data']['n_test']\n",
    "bs_test    = config['test']['batchsize']\n",
    "\n",
    "PDE_MULTIPLIER  = 16        # PDE loss always at 16× the data training res\n",
    "EVAL_MULTIPLIERS = [1, 2, 4, 8, 16]   # relative to each run's data training res\n",
    "\n",
    "# Data training resolutions (None = PDE+IC only, no data loss)\n",
    "# For None, we use Nx_ref=128 as the reference so PDE res = 16×128 = 2048\n",
    "Nx_ref           = 128      # reference for the no-data run's PDE resolution\n",
    "data_resolutions = [128, 64, 32, 16, 8, 4, None]\n",
    "\n",
    "plot_save_dir = 'ablation_plots_16x'\n",
    "os.makedirs(plot_save_dir, exist_ok=True)\n",
    "\n",
    "print(f\"\\nPDE multiplier   : {PDE_MULTIPLIER}× data training res (per run)\")\n",
    "print(f\"Eval multipliers : {EVAL_MULTIPLIERS}× data training res (per run)\")\n",
    "print(f\"Data resolutions : {data_resolutions}\")\n",
    "print(f\"Plots saved to   : {plot_save_dir}/\")\n",
    "print(f\"Checkpoint tag   : ablation-{PDE_MULTIPLIER}x-data<res>.pt\")\n",
    "\n",
    "\n",
    "# ── 2. Training loop ──────────────────────────────────────────────────────────\n",
    "\n",
    "def train_ablation(model, train_loader_data, train_loader_pde,\n",
    "                   optimizer, scheduler, config, device,\n",
    "                   use_data_loss=True, epochs=None):\n",
    "    \"\"\"\n",
    "    Train PINO for one data-resolution condition.\n",
    "    use_data_loss=False → xy_loss weight zeroed (pure PDE + IC).\n",
    "    The data loader still drives iteration count for consistency.\n",
    "    \"\"\"\n",
    "    data_weight = config['train']['xy_loss'] if use_data_loss else 0.0\n",
    "    f_weight    = config['train']['f_loss']\n",
    "    ic_weight   = config['train']['ic_loss']\n",
    "    c_val       = config['data']['c']\n",
    "    n_epochs    = epochs if epochs is not None else config['train']['epochs']\n",
    "    myloss      = LpLoss(size_average=True)\n",
    "\n",
    "    def cycle(loader):\n",
    "        while True:\n",
    "            for batch in loader:\n",
    "                yield batch\n",
    "\n",
    "    pde_iter = cycle(train_loader_pde)\n",
    "\n",
    "    pbar = tqdm(range(n_epochs), dynamic_ncols=True, smoothing=0.1)\n",
    "    for e in pbar:\n",
    "        model.train()\n",
    "        sum_data, sum_total = 0.0, 0.0\n",
    "\n",
    "        for x_lo, y_lo in train_loader_data:\n",
    "            x_lo = x_lo.to(device)\n",
    "            y_lo = y_lo.to(device)\n",
    "\n",
    "            if use_data_loss:\n",
    "                out_lo    = model(x_lo).reshape(y_lo.shape)\n",
    "                data_loss = myloss(out_lo, y_lo)\n",
    "            else:\n",
    "                data_loss = torch.tensor(0.0, device=device)\n",
    "\n",
    "            x_hi, _ = next(pde_iter)\n",
    "            x_hi    = x_hi.to(device)\n",
    "            out_hi  = model(x_hi).reshape(x_hi.shape[0], x_hi.shape[1], x_hi.shape[2])\n",
    "            loss_ic_hi, loss_f_hi = PINO_loss_wave(out_hi, x_hi[:, 0, :, 0], c=c_val)\n",
    "\n",
    "            total_loss = (data_loss   * data_weight\n",
    "                        + loss_ic_hi * ic_weight\n",
    "                        + loss_f_hi  * f_weight)\n",
    "\n",
    "            optimizer.zero_grad()\n",
    "            total_loss.backward()\n",
    "            optimizer.step()\n",
    "\n",
    "            del out_hi, x_hi, loss_ic_hi, loss_f_hi\n",
    "\n",
    "            sum_data  += data_loss.item()\n",
    "            sum_total += total_loss.item()\n",
    "\n",
    "        n = len(train_loader_data)\n",
    "        scheduler.step()\n",
    "        data_str = f'data={sum_data/n:.4f}' if use_data_loss else 'data=OFF'\n",
    "        pbar.set_description(f'Ep {e:>3}  total={sum_total/n:.4f}  {data_str}')\n",
    "\n",
    "    print('Training complete.')\n",
    "\n",
    "\n",
    "# ── 3. Physics residual helper ────────────────────────────────────────────────\n",
    "\n",
    "def compute_normalized_physics_residual(out, c_val):\n",
    "    \"\"\"RMS(u_tt - c²·u_xx) / RMS(u_tt) — dimensionless, resolution-comparable.\"\"\"\n",
    "    Du  = FDM_Wave(out, D=1.0, c=c_val)\n",
    "    nt  = out.size(1)\n",
    "    dt  = 1.0 / (nt - 1)\n",
    "    utt = (out[:, 2:, :] - 2.0 * out[:, 1:-1, :] + out[:, :-2, :]) / dt ** 2\n",
    "    rms_res = Du.pow(2).mean().sqrt()\n",
    "    rms_utt = utt.pow(2).mean().sqrt().clamp(min=1e-8)\n",
    "    return (rms_res / rms_utt).item()\n",
    "\n",
    "\n",
    "# ── 4. Per-run plot helper ────────────────────────────────────────────────────\n",
    "\n",
    "def plot_single_run(run_label, Nx_data_run, Nx_pde_run, res_arr, save_dir):\n",
    "    \"\"\"Save a per-run plot identical in style to the prior experiment.\"\"\"\n",
    "    Nx_vals   = res_arr[:, 0]\n",
    "    mult_vals = res_arr[:, 1]\n",
    "    l2_vals   = res_arr[:, 2]\n",
    "    phys_vals = res_arr[:, 3]\n",
    "\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n",
    "\n",
    "    ax = axes[0]\n",
    "    ax.plot(Nx_vals, l2_vals * 100, 'o-', color='tab:blue', linewidth=2, markersize=8)\n",
    "    if Nx_data_run is not None:\n",
    "        ax.axvline(Nx_data_run, color='gray', ls='--', alpha=0.5,\n",
    "                   label=f'Data train res. (Nx={Nx_data_run})')\n",
    "    ax.axvline(Nx_pde_run, color='salmon', ls=':', alpha=0.7,\n",
    "               label=f'PDE loss res. (Nx={Nx_pde_run}, {PDE_MULTIPLIER}×)')\n",
    "    ax.set_xscale('log', base=2)\n",
    "    ax.set_xticks(Nx_vals)\n",
    "    ax.get_xaxis().set_major_formatter(plt.ScalarFormatter())\n",
    "    ax.set_xticklabels([f'{int(nx)}\\n({int(m)}×)' for nx, m in zip(Nx_vals, mult_vals)])\n",
    "    ax.set_xlabel('Spatial resolution $N_x$ (× data training res)')\n",
    "    ax.set_ylabel('Relative $L^2$ error (%)')\n",
    "    ax.set_title('Prediction error vs. resolution')\n",
    "    ax.grid(True, alpha=0.2)\n",
    "    ax.legend()\n",
    "\n",
    "    ax = axes[1]\n",
    "    ax.plot(Nx_vals, phys_vals, 's-', color='tab:orange', linewidth=2, markersize=8)\n",
    "    if Nx_data_run is not None:\n",
    "        ax.axvline(Nx_data_run, color='gray', ls='--', alpha=0.5,\n",
    "                   label=f'Data train res. (Nx={Nx_data_run})')\n",
    "    ax.axvline(Nx_pde_run, color='salmon', ls=':', alpha=0.7,\n",
    "               label=f'PDE loss res. (Nx={Nx_pde_run}, {PDE_MULTIPLIER}×)')\n",
    "    ax.set_yscale('log')\n",
    "    ax.set_xscale('log', base=2)\n",
    "    ax.set_xticks(Nx_vals)\n",
    "    ax.get_xaxis().set_major_formatter(plt.ScalarFormatter())\n",
    "    ax.set_xticklabels([f'{int(nx)}\\n({int(m)}×)' for nx, m in zip(Nx_vals, mult_vals)])\n",
    "    ax.set_xlabel('Spatial resolution $N_x$ (× data training res)')\n",
    "    ax.set_ylabel('Normalized physics residual\\n'\n",
    "                  r'$\\mathrm{RMS}(u_{tt} - c^2 u_{xx})\\;/\\;\\mathrm{RMS}(u_{tt})$')\n",
    "    ax.set_title('Normalized physics residual vs. resolution')\n",
    "    ax.grid(True, alpha=0.2, which='both')\n",
    "    ax.legend()\n",
    "\n",
    "    data_str = f'Nx={Nx_data_run}' if Nx_data_run is not None else 'No data'\n",
    "    plt.suptitle(\n",
    "        f'Resolution invariance — Wave 1D PINO\\n'\n",
    "        f'(Data @ {data_str}; PDE loss @ Nx={Nx_pde_run} [{PDE_MULTIPLIER}×])',\n",
    "        y=1.03,\n",
    "    )\n",
    "    plt.tight_layout()\n",
    "    fname = os.path.join(save_dir, f'run_data{Nx_data_run}.png')\n",
    "    plt.savefig(fname, dpi=150, bbox_inches='tight')\n",
    "    plt.show()\n",
    "    print(f\"  Saved: {fname}\")\n",
    "\n",
    "# ── helper: cap modes to what Nx can support ──────────────────────────────────\n",
    "\n",
    "def make_model_for_nx(config, Nx, device):\n",
    "    \"\"\"\n",
    "    Build FNN2d with Fourier modes capped at Nx // 2 - 1.\n",
    "    This is the correct thing to do: modes > Nx//2 are meaningless (no\n",
    "    frequency content there), so capping is mathematically lossless for\n",
    "    the given grid, not an approximation.\n",
    "    \"\"\"\n",
    "    max_modes = max(1, Nx // 2 - 1)\n",
    "    modes1 = [min(m, max_modes) for m in config['model']['modes1']]\n",
    "    modes2 = [min(m, max_modes) for m in config['model']['modes2']]\n",
    "\n",
    "    if modes1 != config['model']['modes1'] or modes2 != config['model']['modes2']:\n",
    "        print(f\"    ↳ modes capped: {config['model']['modes1']} → {modes1} \"\n",
    "              f\"(Nx={Nx} supports max {max_modes} modes)\")\n",
    "\n",
    "    return FNN2d(\n",
    "        modes1=modes1,\n",
    "        modes2=modes2,\n",
    "        fc_dim=config['model']['fc_dim'],\n",
    "        layers=config['model']['layers'],\n",
    "        activation=config['model']['activation'],\n",
    "    ).to(device)\n",
    "\n",
    "# ── 5. Main loop ──────────────────────────────────────────────────────────────\n",
    "\n",
    "min_nx      = 2 * max(config['model']['modes2'])\n",
    "all_results = {}   # label → np.array of (Nx_eval, mult, rel_L2, norm_phys)\n",
    "myloss      = LpLoss(size_average=True)\n",
    "\n",
    "for Nx_data in data_resolutions:\n",
    "    use_data    = Nx_data is not None\n",
    "    Nx_ref_run  = Nx_data if use_data else Nx_ref\n",
    "\n",
    "    # PDE resolution = 16× data res; capped at N (dataset limit)\n",
    "    Nx_pde_run  = min(N, Nx_ref_run * PDE_MULTIPLIER)\n",
    "    sub_x_pde   = N // Nx_pde_run\n",
    "    bs_pde      = max(1, config['train']['batchsize'] // PDE_MULTIPLIER)\n",
    "\n",
    "    run_label   = f'Nx={Nx_data}' if use_data else 'No data (PDE+IC only)'\n",
    "    ckpt_name   = (f'ablation-{PDE_MULTIPLIER}x-data{Nx_data}.pt'\n",
    "                   if use_data else f'ablation-{PDE_MULTIPLIER}x-datanone.pt')\n",
    "    ckpt_path   = os.path.join('checkpoints', config['train']['save_dir'], ckpt_name)\n",
    "\n",
    "    print(f\"\\n{'='*65}\")\n",
    "    print(f\"  Run : {run_label}\")\n",
    "    print(f\"  PDE : Nx={Nx_pde_run}  (sub_x={sub_x_pde}, batch={bs_pde})\")\n",
    "    print(f\"  Ckpt: {ckpt_path}\")\n",
    "    print(f\"{'='*65}\")\n",
    "\n",
    "    # ── 5a. Build model ───────────────────────────────────────────────────────\n",
    "    # Use the data res for mode capping; for no-data run use PDE res since\n",
    "    # there's no data grid constraint — the model only ever sees Nx_pde_run.\n",
    "    nx_for_modes = Nx_ref_run if use_data else Nx_pde_run\n",
    "    model_run    = make_model_for_nx(config, nx_for_modes, EXPERIMENT_DEVICE)\n",
    "\n",
    "    optimizer_run = Adam(model_run.parameters(), betas=(0.9, 0.999),\n",
    "                         lr=config['train']['base_lr'])\n",
    "    scheduler_run = torch.optim.lr_scheduler.MultiStepLR(\n",
    "        optimizer_run,\n",
    "        milestones=config['train']['milestones'],\n",
    "        gamma=config['train']['scheduler_gamma'],\n",
    "    )\n",
    "\n",
    "    # ── 5b. Train or load ─────────────────────────────────────────────────────\n",
    "    if os.path.exists(ckpt_path):\n",
    "        print(f\"  Checkpoint found — skipping training.\")\n",
    "        load_checkpoint(model_run, ckpt_path, optimizer=optimizer_run)\n",
    "        model_run = model_run.to(EXPERIMENT_DEVICE)\n",
    "    else:\n",
    "        # PDE loader at this run's PDE resolution\n",
    "        ds_pde_run       = DataLoader1D(a, u, nx=N, nt=Nt0,\n",
    "                                        sub=sub_x_pde, sub_t=sub_t_data)\n",
    "        train_loader_pde = ds_pde_run.make_loader(n_train, bs_pde,\n",
    "                                                  start=0, train=True)\n",
    "\n",
    "        # Data loader: use dummy at Nx_ref=128 for no-data run (drives loop count)\n",
    "        sub_x_data_run = N // Nx_ref_run\n",
    "        bs_run         = config['train']['batchsize'] if use_data else 4\n",
    "        ds_data_run    = DataLoader1D(a, u, nx=N, nt=Nt0,\n",
    "                                      sub=sub_x_data_run, sub_t=sub_t_data)\n",
    "        train_loader_run = ds_data_run.make_loader(n_train, bs_run,\n",
    "                                                   start=0, train=True)\n",
    "\n",
    "        print(f\"  Training (data batch={'N/A' if not use_data else bs_run}, \"\n",
    "              f\"PDE batch={bs_pde}) ...\")\n",
    "        train_ablation(\n",
    "            model_run, train_loader_run, train_loader_pde,\n",
    "            optimizer_run, scheduler_run, config,\n",
    "            device=EXPERIMENT_DEVICE,\n",
    "            use_data_loss=use_data,\n",
    "        )\n",
    "        save_checkpoint(config['train']['save_dir'], ckpt_name,\n",
    "                        model_run, optimizer_run)\n",
    "        print(f\"  Saved: {ckpt_path}\")\n",
    "\n",
    "    # ── 5c. Eval sweep at 1×, 2×, 4×, 8×, 16× this run's data res ───────────\n",
    "    print(f\"\\n  Evaluating at multipliers {EVAL_MULTIPLIERS}× of Nx={Nx_ref_run} ...\")\n",
    "    run_results = []\n",
    "    model_run.eval()\n",
    "\n",
    "    for mult in EVAL_MULTIPLIERS:\n",
    "        Nx_eval    = Nx_ref_run * mult\n",
    "        sub_x_eval = N // Nx_eval\n",
    "\n",
    "        if Nx_eval > N:\n",
    "            print(f\"    Skipping {mult}× (Nx={Nx_eval} > dataset size N={N})\")\n",
    "            continue\n",
    "        # if Nx_eval < min_nx:\n",
    "        #     print(f\"    Skipping {mult}× (Nx={Nx_eval} < 2×modes={min_nx})\")\n",
    "        #     continue\n",
    "\n",
    "        ds_ev     = DataLoader1D(a, u, nx=N, nt=Nt0,\n",
    "                                 sub=sub_x_eval, sub_t=sub_t_data)\n",
    "        loader_ev = ds_ev.make_loader(n_test, bs_test,\n",
    "                                      start=n_train, train=False)\n",
    "\n",
    "        l2_list, phys_list = [], []\n",
    "        with torch.no_grad():\n",
    "            for x_ev, y_ev in loader_ev:\n",
    "                x_ev = x_ev.to(EXPERIMENT_DEVICE)\n",
    "                y_ev = y_ev.to(EXPERIMENT_DEVICE)\n",
    "                out_ev = model_run(x_ev).reshape(y_ev.shape)\n",
    "                l2_list.append(myloss(out_ev, y_ev).item())\n",
    "                phys_list.append(compute_normalized_physics_residual(out_ev, c))\n",
    "\n",
    "        mean_l2   = float(np.mean(l2_list))\n",
    "        mean_phys = float(np.mean(phys_list))\n",
    "        print(f\"    {mult:>2}× Nx={Nx_eval:>5}  L2={mean_l2*100:.4f}%  \"\n",
    "              f\"Phys={mean_phys:.6f}\")\n",
    "        run_results.append((Nx_eval, mult, mean_l2, mean_phys))\n",
    "\n",
    "    run_results = np.array(run_results)\n",
    "    all_results[run_label] = (Nx_ref_run, Nx_pde_run, run_results)\n",
    "\n",
    "    # Per-run plot\n",
    "    plot_single_run(run_label, Nx_data, Nx_pde_run, run_results, plot_save_dir)\n",
    "\n",
    "    del model_run\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "\n",
    "# ── 6. Combined plot (x-axis = relative multiplier) ──────────────────────────\n",
    "\n",
    "%matplotlib inline\n",
    "\n",
    "labels  = list(all_results.keys())\n",
    "colors  = cm.viridis(np.linspace(0.1, 0.9, len(labels)))\n",
    "no_data_label = 'No data (PDE+IC only)'\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "for (label, (Nx_ref_run, Nx_pde_run, res_arr)), color in zip(all_results.items(), colors):\n",
    "    mult_vals = res_arr[:, 1]    # always [1, 2, 4, 8, 16] — relative, comparable\n",
    "    l2_vals   = res_arr[:, 2]\n",
    "    phys_vals = res_arr[:, 3]\n",
    "    is_no_data = (label == no_data_label)\n",
    "    ls = '--' if is_no_data else '-'\n",
    "    mk = 'x'  if is_no_data else 'o'\n",
    "\n",
    "    axes[0].plot(mult_vals, l2_vals * 100, marker=mk, ls=ls,\n",
    "                 color=color, linewidth=2, markersize=8, label=label)\n",
    "    axes[1].plot(mult_vals, phys_vals, marker=mk, ls=ls,\n",
    "                 color=color, linewidth=2, markersize=8, label=label)\n",
    "\n",
    "for ax in axes:\n",
    "    ax.axvline(PDE_MULTIPLIER, color='salmon', ls=':', alpha=0.8,\n",
    "               label=f'PDE loss res. ({PDE_MULTIPLIER}× data res)')\n",
    "    ax.set_xscale('log', base=2)\n",
    "    ax.set_xticks(EVAL_MULTIPLIERS)\n",
    "    ax.get_xaxis().set_major_formatter(plt.ScalarFormatter())\n",
    "    ax.set_xticklabels([f'{m}×' for m in EVAL_MULTIPLIERS])\n",
    "    ax.set_xlabel('Eval resolution (× data training res)')\n",
    "    ax.grid(True, alpha=0.2)\n",
    "    ax.legend(fontsize=8, loc='upper left')\n",
    "\n",
    "axes[0].set_ylabel('Relative $L^2$ error (%)')\n",
    "axes[0].set_title('Prediction error vs. resolution')\n",
    "\n",
    "axes[1].set_yscale('log')\n",
    "axes[1].set_ylabel('Normalized physics residual\\n'\n",
    "                   r'$\\mathrm{RMS}(u_{tt} - c^2 u_{xx})\\;/\\;\\mathrm{RMS}(u_{tt})$')\n",
    "axes[1].set_title('Normalized physics residual vs. resolution')\n",
    "axes[1].grid(True, alpha=0.2, which='both')\n",
    "\n",
    "plt.suptitle(\n",
    "    f'Data resolution ablation — Wave 1D PINO\\n'\n",
    "    f'(PDE loss always @ {PDE_MULTIPLIER}× data res; '\n",
    "    f'x-axis relative to each run\\'s data res)',\n",
    "    y=1.03,\n",
    ")\n",
    "plt.tight_layout()\n",
    "combined_path = os.path.join(plot_save_dir, 'combined.png')\n",
    "plt.savefig(combined_path, dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(f\"Combined plot saved: {combined_path}\")\n",
    "\n",
    "\n",
    "# ── 7. Summary table ──────────────────────────────────────────────────────────\n",
    "\n",
    "print(f\"\\n{'='*75}\")\n",
    "print(f\"  {'Run':>22}  {'Mult':>5}  {'Nx_eval':>7}  {'Rel L2 (%)':>12}  {'Norm phys':>12}\")\n",
    "print(f\"{'='*75}\")\n",
    "for label, (Nx_ref_run, Nx_pde_run, res_arr) in all_results.items():\n",
    "    print(f\"\\n  {label}  (PDE @ Nx={Nx_pde_run})\")\n",
    "    for nx_v, mult_v, l2_v, ph_v in res_arr:\n",
    "        pde_tag = '  ← PDE res' if int(nx_v) == Nx_pde_run else ''\n",
    "        print(f\"  {'':>22}  {int(mult_v):>4}×  {int(nx_v):>7}  \"\n",
    "              f\"{l2_v*100:>12.4f}%  {ph_v:>12.6f}{pde_tag}\")\n",
    "print(f\"\\n{'='*75}\")"
   ]
  },
