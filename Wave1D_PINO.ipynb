    "sub_x_list = [128, 64, 32, 16, 8, 4, 2, 1]\n",
    "\n",
    "print(f\"\\nEval resolutions (Nx): {[N_full // s for s in sub_x_list]}\")\n",
    "print(f\"Multipliers of train res: {[round((N_full // s) / Nx_train, 1) for s in sub_x_list]}\")\n",
    "print()\n",
    "\n",
