      "File \u001b[0;32m~/PINO-apps/.venv/lib/python3.12/site-packages/torch/_tensor.py:647\u001b[0m, in \u001b[0;36mTensor.backward\u001b[0;34m(self, gradient, retain_graph, create_graph, inputs)\u001b[0m\n\u001b[1;32m    637\u001b[0m \u001b[38;5;28;01mif\u001b[39;00m has_torch_function_unary(\u001b[38;5;28mself\u001b[39m):\n\u001b[1;32m    638\u001b[0m     \u001b[38;5;28;01mreturn\u001b[39;00m handle_torch_function(\n\u001b[1;32m    639\u001b[0m         Tensor\u001b[38;5;241m.\u001b[39mbackward,\n\u001b[1;32m    640\u001b[0m         (\u001b[38;5;28mself\u001b[39m,),\n\u001b[0;32m   (...)\u001b[0m\n\u001b[1;32m    645\u001b[0m         inputs\u001b[38;5;241m=\u001b[39minputs,\n\u001b[1;32m    646\u001b[0m     )\n\u001b[0;32m--> 647\u001b[0m \u001b[43mtorch\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mautograd\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mbackward\u001b[49m\u001b[43m(\u001b[49m\n\u001b[1;32m    648\u001b[0m \u001b[43m    \u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mgradient\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mretain_graph\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mcreate_graph\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43minputs\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43minputs\u001b[49m\n\u001b[1;32m    649\u001b[0m \u001b[43m\u001b[49m\u001b[43m)\u001b[49m\n",
      "File \u001b[0;32m~/PINO-apps/.venv/lib/python3.12/site-packages/torch/autograd/__init__.py:354\u001b[0m, in \u001b[0;36mbackward\u001b[0;34m(tensors, grad_tensors, retain_graph, create_graph, grad_variables, inputs)\u001b[0m\n\u001b[1;32m    349\u001b[0m     retain_graph \u001b[38;5;241m=\u001b[39m create_graph\n\u001b[1;32m    351\u001b[0m \u001b[38;5;66;03m# The reason we repeat the same comment below is that\u001b[39;00m\n\u001b[1;32m    352\u001b[0m \u001b[38;5;66;03m# some Python versions print out the first line of a multi-line function\u001b[39;00m\n\u001b[1;32m    353\u001b[0m \u001b[38;5;66;03m# calls in the traceback and some print out the last line\u001b[39;00m\n\u001b[0;32m--> 354\u001b[0m \u001b[43m_engine_run_backward\u001b[49m\u001b[43m(\u001b[49m\n\u001b[1;32m    355\u001b[0m \u001b[43m    \u001b[49m\u001b[43mtensors\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m    356\u001b[0m \u001b[43m    \u001b[49m\u001b[43mgrad_tensors_\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m    357\u001b[0m \u001b[43m    \u001b[49m\u001b[43mretain_graph\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m    358\u001b[0m \u001b[43m    \u001b[49m\u001b[43mcreate_graph\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m    359\u001b[0m \u001b[43m    \u001b[49m\u001b[43minputs_tuple\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m    360\u001b[0m \u001b[43m    \u001b[49m\u001b[43mallow_unreachable\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[38;5;28;43;01mTrue\u001b[39;49;00m\u001b[43m,\u001b[49m\n\u001b[1;32m    361\u001b[0m \u001b[43m    \u001b[49m\u001b[43maccumulate_grad\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[38;5;28;43;01mTrue\u001b[39;49;00m\u001b[43m,\u001b[49m\n\u001b[1;32m    362\u001b[0m \u001b[43m\u001b[49m\u001b[43m)\u001b[49m\n",
      "File \u001b[0;32m~/PINO-apps/.venv/lib/python3.12/site-packages/torch/autograd/graph.py:829\u001b[0m, in \u001b[0;36m_engine_run_backward\u001b[0;34m(t_outputs, *args, **kwargs)\u001b[0m\n\u001b[1;32m    827\u001b[0m     unregister_hooks \u001b[38;5;241m=\u001b[39m _register_logging_hooks_on_whole_graph(t_outputs)\n\u001b[1;32m    828\u001b[0m \u001b[38;5;28;01mtry\u001b[39;00m:\n\u001b[0;32m--> 829\u001b[0m     \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[43mVariable\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43m_execution_engine\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mrun_backward\u001b[49m\u001b[43m(\u001b[49m\u001b[43m  \u001b[49m\u001b[38;5;66;43;03m# Calls into the C++ engine to run the backward pass\u001b[39;49;00m\n\u001b[1;32m    830\u001b[0m \u001b[43m        \u001b[49m\u001b[43mt_outputs\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[38;5;241;43m*\u001b[39;49m\u001b[43margs\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[38;5;241;43m*\u001b[39;49m\u001b[38;5;241;43m*\u001b[39;49m\u001b[43mkwargs\u001b[49m\n\u001b[1;32m    831\u001b[0m \u001b[43m    \u001b[49m\u001b[43m)\u001b[49m  \u001b[38;5;66;03m# Calls into the C++ engine to run the backward pass\u001b[39;00m\n\u001b[1;32m    832\u001b[0m \u001b[38;5;28;01mfinally\u001b[39;00m:\n\u001b[1;32m    833\u001b[0m     \u001b[38;5;28;01mif\u001b[39;00m attach_logging_hooks:\n",
      "\u001b[0;31mKeyboardInterrupt\u001b[0m: "
     ]
    }
   ],
   "source": [
    "# =============================================================================\n",
    "# PINO Wave 1D — Zero-Shot Super-Resolution Replication\n",
    "# -----------------------------------------------------------------------------\n",
    "# Replicates the PINO paper experiment: train with data at fixed low resolution\n",
    "# (Nx = N // sub_x_data) and PDE loss at a higher resolution (pde_multiplier ×\n",
    "# the data resolution). At eval time, test at 1×, 2×, 4×, 8×, 16× — the model\n",
    "# should not lose performance up to the PDE training resolution.\n",
    "#\n",
    "# Key design choices (matching the paper):\n",
    "#   - Data loss evaluated on low-res grid only.\n",
    "#   - PDE loss evaluated on high-res grid (any resolution — no ground truth\n",
    "#     needed, just initial conditions).\n",
    "#   - Physics residual NORMALIZED by RMS(u_tt) so it is dimensionless and\n",
    "#     directly comparable across all eval resolutions.\n",
    "#   - We do NOT evaluate beyond the PDE training resolution (no extrapolation).\n",
    "#\n",
    "# OOM fixes vs naive implementation:\n",
    "#   - Separate (smaller) batch size for high-res PDE pass: bs_pde ~ bs_data / pde_multiplier.\n",
    "#   - del out_hi immediately after backward to free VRAM.\n",
    "#   - torch.cuda.empty_cache() before training.\n",
    "#   - Explicit experiment device (defaults to cuda:0; change EXPERIMENT_DEVICE).\n",
    "#\n",
    "# To run at 32× instead of 16× (if VRAM allows — needs ~4 GB extra headroom):\n",
    "#   - Uncomment the pde_multiplier = 32 line and comment out pde_multiplier = 16.\n",
    "#   - Add 32 to eval_multipliers.\n",
    "#   - bs_pde will auto-scale to bs_data // 32, likely 1 — acceptable.\n",
    "# =============================================================================\n",
    "\n",
    "import numpy as np\n",
    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "from tqdm import tqdm\n",
    "from train_utils.losses import LpLoss\n",
    "from train_utils.datasets import DataLoader1D\n",
    "from train_utils.utils import save_checkpoint\n",
    "\n",
    "# ── 0. Device and memory setup ────────────────────────────────────────────────\n",
    "\n",
    "EXPERIMENT_DEVICE = torch.device('cuda:0')   # ← change to 'cuda:1', 'cuda:2', etc.\n",
    "torch.cuda.empty_cache()\n",
    "print(f\"Running on: {EXPERIMENT_DEVICE}\")\n",
    "print(f\"  Free VRAM: {torch.cuda.mem_get_info(EXPERIMENT_DEVICE)[0] / 1e9:.2f} GB\")\n",
    "\n",
    "\n",
    "# ── 1. Resolution config ──────────────────────────────────────────────────────\n",
    "\n",
    "sub_x_data = config['data']['sub']      # e.g. 32 → Nx_data = N // 32 = 128\n",
    "sub_t_data = config['data']['sub_t']\n",
    "c          = config['data']['c']\n",
    "\n",
    "# PDE training resolution multiplier.\n",
    "# Paper trains PDE loss at the highest resolution to be tested at eval time.\n",
    "# pde_multiplier = 16    # → PDE loss at 16× data res (Nx_pde = 2048 if Nx_data=128)\n",
    "pde_multiplier = 32  # ← uncomment for 32× (Nx_pde = 4096); needs ~4 GB extra VRAM\n",
    "\n",
    "sub_x_pde = max(1, sub_x_data // pde_multiplier)\n",
    "Nx_data   = N // sub_x_data\n",
    "Nx_pde    = N // sub_x_pde    # == pde_multiplier * Nx_data\n",
    "\n",
    "# Batch sizes: scale PDE batch inversely with spatial resolution to keep\n",
    "# activation memory roughly constant. bs_pde = bs_data // pde_multiplier,\n",
    "# clamped to at least 1.\n",
    "bs_data = config['train']['batchsize']\n",
    "# bs_pde  = max(1, bs_data // pde_multiplier)\n",
    "bs_pde = 2\n",
    "bs_test = config['test']['batchsize']\n",
    "\n",
    "print(f\"\\nData resolution : Nx = {Nx_data}  (sub_x = {sub_x_data}, batch = {bs_data})\")\n",
    "print(f\"PDE  resolution : Nx = {Nx_pde}  (sub_x = {sub_x_pde}, batch = {bs_pde})  [{pde_multiplier}× data res]\")\n",
    "print(f\"Temporal points : Nt = {Nt0 // sub_t_data + 1}\")\n",
    "print(f\"Peak high-res tensor : ~{bs_pde * (Nt0 // sub_t_data + 1) * Nx_pde * 4 / 1e6:.1f} MB\")\n",
    "\n",
    "\n",
    "# ── 2. Training loop ──────────────────────────────────────────────────────────\n",
    "\n",
    "def train_wave_multires(model, train_loader_data, train_loader_pde,\n",
    "                        optimizer, scheduler, config, device, epochs=None):\n",
    "    \"\"\"\n",
    "    Train PINO with:\n",
    "      - data loss (rel L2) at low-res grid\n",
    "      - IC + PDE loss at high-res grid (paper's zero-shot super-resolution recipe)\n",
    "\n",
    "    train_loader_pde is cycled so its length doesn't need to match train_loader_data.\n",
    "    High-res outputs are freed immediately after backward to minimize peak VRAM.\n",
    "    \"\"\"\n",
    "    data_weight = config['train']['xy_loss']\n",
    "    f_weight    = config['train']['f_loss']\n",
    "    ic_weight   = config['train']['ic_loss']\n",
    "    c_val       = config['data']['c']\n",
    "    n_epochs    = epochs if epochs is not None else config['train']['epochs']\n",
    "    myloss      = LpLoss(size_average=True)\n",
    "\n",
    "    def cycle(loader):\n",
    "        while True:\n",
    "            for batch in loader:\n",
    "                yield batch\n",
    "\n",
    "    pde_iter = cycle(train_loader_pde)\n",
    "\n",
    "    pbar = tqdm(range(n_epochs), dynamic_ncols=True, smoothing=0.1)\n",
    "    for e in pbar:\n",
    "        model.train()\n",
    "        sum_data, sum_pde, sum_ic, sum_total = 0.0, 0.0, 0.0, 0.0\n",
    "\n",
    "        for x_lo, y_lo in train_loader_data:\n",
    "            x_lo = x_lo.to(device)\n",
    "            y_lo = y_lo.to(device)\n",
    "\n",
    "            # (a) Data loss at low resolution\n",
    "            out_lo    = model(x_lo).reshape(y_lo.shape)\n",
    "            data_loss = myloss(out_lo, y_lo)\n",
    "\n",
    "            # (b) PDE + IC loss at high resolution (small batch, no ground truth)\n",
    "            x_hi, _ = next(pde_iter)\n",
    "            x_hi    = x_hi.to(device)\n",
    "            out_hi  = model(x_hi).reshape(x_hi.shape[0], x_hi.shape[1], x_hi.shape[2])\n",
    "\n",
    "            loss_ic_hi, loss_f_hi = PINO_loss_wave(out_hi, x_hi[:, 0, :, 0], c=c_val)\n",
    "\n",
    "            total_loss = (data_loss   * data_weight\n",
    "                        + loss_ic_hi * ic_weight\n",
    "                        + loss_f_hi  * f_weight)\n",
    "\n",
    "            optimizer.zero_grad()\n",
    "            total_loss.backward()\n",
    "            optimizer.step()\n",
    "\n",
    "            # Free high-res output immediately — don't let it accumulate across iters\n",
    "            del out_hi, x_hi, loss_ic_hi, loss_f_hi\n",
    "\n",
    "            sum_data  += data_loss.item()\n",
    "            sum_pde   += loss_f_hi.item() if False else 0.0   # already freed; logged via total\n",
    "            sum_total += total_loss.item()\n",
    "\n",
    "        n = len(train_loader_data)\n",
    "        scheduler.step()\n",
    "        pbar.set_description(\n",
    "            f'Ep {e:>3}  total={sum_total/n:.4f}  data={sum_data/n:.4f}'\n",
    "        )\n",
    "\n",
    "    print('Training complete.')\n",
    "\n",
    "\n",
    "# ── 3. Build loaders ──────────────────────────────────────────────────────────\n",
    "\n",
    "n_train = config['data']['n_train']\n",
    "n_test  = config['data']['n_test']\n",
    "\n",
    "ds_data          = DataLoader1D(a, u, nx=N, nt=Nt0, sub=sub_x_data, sub_t=sub_t_data)\n",
    "train_loader     = ds_data.make_loader(n_train, bs_data, start=0,       train=True)\n",
    "test_loader      = ds_data.make_loader(n_test,  bs_test, start=n_train, train=False)\n",
    "\n",
    "ds_pde           = DataLoader1D(a, u, nx=N, nt=Nt0, sub=sub_x_pde, sub_t=sub_t_data)\n",
    "train_loader_pde = ds_pde.make_loader(n_train, bs_pde, start=0, train=True)\n",
    "\n",
    "\n",
    "# ── 4. Model, optimizer, scheduler ───────────────────────────────────────────\n",
    "\n",
    "model_pino = FNN2d(\n",
    "    modes1=config['model']['modes1'],\n",
    "    modes2=config['model']['modes2'],\n",
    "    fc_dim=config['model']['fc_dim'],\n",
    "    layers=config['model']['layers'],\n",
    "    activation=config['model']['activation'],\n",
    ").to(EXPERIMENT_DEVICE)\n",
    "\n",
    "optimizer_pino = Adam(model_pino.parameters(), betas=(0.9, 0.999),\n",
    "                      lr=config['train']['base_lr'])\n",
    "scheduler_pino = torch.optim.lr_scheduler.MultiStepLR(\n",
    "    optimizer_pino,\n",
    "    milestones=config['train']['milestones'],\n",
    "    gamma=config['train']['scheduler_gamma'],\n",
    ")\n",
    "\n",
    "print(f\"\\n{'='*60}\")\n",
    "print(f\"Training PINO  (data @ Nx={Nx_data} [1×],  PDE loss @ Nx={Nx_pde} [{pde_multiplier}×])\")\n",
    "print(f\"  data batch = {bs_data},  PDE batch = {bs_pde}\")\n",
    "print(f\"{'='*60}\\n\")\n",
    "\n",
    "train_wave_multires(\n",
    "    model_pino, train_loader, train_loader_pde,\n",
    "    optimizer_pino, scheduler_pino, config,\n",
    "    device=EXPERIMENT_DEVICE,\n",
    ")\n",
    "\n",
    "save_checkpoint(\n",
    "    config['train']['save_dir'],\n",
    "    config['train']['save_name'].replace('.pt', f'_pde{pde_multiplier}x.pt'),\n",
    "    model_pino, optimizer_pino,\n",
    ")\n",
    "\n",
    "\n",
    "# ── 5. Normalized physics residual helper ─────────────────────────────────────\n",
    "\n",
    "def compute_normalized_physics_residual(out, c_val):\n",
    "    \"\"\"\n",
    "    Dimensionless physics residual: RMS(u_tt - c²·u_xx) / RMS(u_tt).\n",
    "\n",
    "    Dividing by RMS(u_tt) removes the dt^{-2} resolution dependence so the\n",
    "    metric is directly comparable across all eval resolutions.\n",
    "    A value near 0 means the model satisfies the wave equation at that grid.\n",
    "    \"\"\"\n",
    "    Du  = FDM_Wave(out, D=1.0, c=c_val)   # shape (B, Nt-2, Nx)\n",
    "    nt  = out.size(1)\n",
    "    dt  = 1.0 / (nt - 1)\n",
    "    utt = (out[:, 2:, :] - 2.0 * out[:, 1:-1, :] + out[:, :-2, :]) / dt ** 2\n",
    "\n",
    "    rms_res = Du.pow(2).mean().sqrt()\n",
    "    rms_utt = utt.pow(2).mean().sqrt().clamp(min=1e-8)\n",
    "    return (rms_res / rms_utt).item()\n",
    "\n",
    "\n",
    "# ── 6. Resolution sweep ───────────────────────────────────────────────────────\n",
    "#\n",
    "# We only evaluate up to pde_multiplier×: the paper's claim is that the model\n",
    "# stays accurate up to the resolution the PDE loss was trained at. Evaluating\n",
    "# beyond that is extrapolation and is expected to degrade.\n",
    "\n",
    "# eval_multipliers = [1, 2, 4, 8, 16]\n",
    "eval_multipliers = [1, 2, 4, 8, 16, 32]  # ← uncomment if pde_multiplier = 32\n",
    "\n",
    "results = []   # rows: (Nx_eval, multiplier, rel_L2, norm_phys_res)\n",
    "myloss  = LpLoss(size_average=True)\n",
    "min_nx  = 2 * max(config['model']['modes2'])   # FNO hard minimum\n",
    "\n",
    "model_pino.eval()\n",
    "for mult in eval_multipliers:\n",
    "    sub_x_eval = max(1, sub_x_data // mult)\n",
    "    Nx_eval    = N // sub_x_eval\n",
    "\n",
    "    if Nx_eval < min_nx:\n",
    "        print(f\"Skipping {mult}× (Nx={Nx_eval} < 2×modes={min_nx})\")\n",
    "        continue\n",
    "\n",
    "    print(f\"  {mult:>2}× (Nx={Nx_eval:>5}) ...\", end=\" \", flush=True)\n",
    "\n",
