    "# Compute per-sample relative L2 at each resolution\n",
    "# rel_L2 = ||pred - true||_2 / ||true||_2\n",
    "def batch_rel_l2(preds, trues):\n",
    "    \"\"\"Shape: (N, Nt, Nx) → scalar per sample, then mean.\"\"\"\n",
    "    diff  = preds - trues\n",
