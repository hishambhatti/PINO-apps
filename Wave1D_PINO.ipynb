   "source": [
    "# =============================================================================\n",
    "# PINO Wave 1D — Data Resolution Ablation (PDE @ 16× training res)\n",
    "# Extended with:\n",
    "#   - Per-resolution paired baselines (PDE+IC only at same 16× res as data run)\n",
    "#   - Global no-data reference at Nx=2048 as before\n",
    "#   - Training loss curves (data, PDE, total) logged every epoch\n",
    "#   - Periodic validation L2 on held-out test set (every VAL_FREQ epochs)\n",
    "#   - Combined PDE-baseline-only plot at the end for cross-resolution comparison\n",
    "#\n",
    "# Toggles at the top of section 1:\n",
    "#   TRAIN_BASELINES  — if True, trains a matched PDE-only model per data res\n",
    "#   LOG_TRAINING     — if True, logs loss curves and periodic validation\n",
    "# =============================================================================\n",
    "\n",
    "import os\n",
    "import numpy as np\n",
    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.cm as cm\n",
    "from tqdm import tqdm\n",
    "from train_utils.losses import LpLoss\n",
    "from train_utils.datasets import DataLoader1D\n",
    "from train_utils.utils import save_checkpoint, load_checkpoint\n",
    "\n",
    "# ── 0. Device ─────────────────────────────────────────────────────────────────\n",
    "\n",
    "EXPERIMENT_DEVICE = torch.device('cuda:0')\n",
    "torch.cuda.empty_cache()\n",
    "print(f\"Running on: {EXPERIMENT_DEVICE}\")\n",
    "print(f\"  Free VRAM: {torch.cuda.mem_get_info(EXPERIMENT_DEVICE)[0] / 1e9:.2f} GB\")\n",
    "\n",
    "\n",
    "# ── 1. Experiment config ──────────────────────────────────────────────────────\n",
    "\n",
    "# ── Toggles ───────────────────────────────────────────────────────────────────\n",
    "TRAIN_BASELINES = True    # train matched PDE-only model per data resolution\n",
    "LOG_TRAINING    = True    # log loss curves + periodic validation\n",
    "VAL_FREQ        = 50      # validate every N epochs (only if LOG_TRAINING=True)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "sub_t_data = config['data']['sub_t']\n",
    "c          = config['data']['c']\n",
    "n_train    = config['data']['n_train']\n",
    "n_test     = config['data']['n_test']\n",
    "bs_test    = config['test']['batchsize']\n",
    "\n",
    "PDE_MULTIPLIER   = 16\n",
    "EVAL_MULTIPLIERS = [1, 2, 4, 8, 16]\n",
    "\n",
    "Nx_ref           = 128   # PDE resolution anchor for global no-data run\n",
    "data_resolutions = [128, 64, 32, 16, 8, 4, None]\n",
    "\n",
    "plot_save_dir = 'ablation_plots_16x'\n",
    "os.makedirs(plot_save_dir, exist_ok=True)\n",
    "\n",
    "print(f\"\\nPDE multiplier   : {PDE_MULTIPLIER}×\")\n",
    "print(f\"Eval multipliers : {EVAL_MULTIPLIERS}×\")\n",
    "print(f\"Data resolutions : {data_resolutions}\")\n",
    "print(f\"TRAIN_BASELINES  : {TRAIN_BASELINES}\")\n",
    "print(f\"LOG_TRAINING     : {LOG_TRAINING}  (val every {VAL_FREQ} epochs)\")\n",
    "print(f\"Plots saved to   : {plot_save_dir}/\")\n",
    "\n",
    "\n",
    "# ── 2. Model builder ──────────────────────────────────────────────────────────\n",
    "\n",
    "def make_model_for_nx(config, Nx, device):\n",
    "    \"\"\"FNN2d with Fourier modes capped at what Nx can support.\"\"\"\n",
    "    max_modes = max(1, Nx // 2 - 1)\n",
    "    modes1 = [min(m, max_modes) for m in config['model']['modes1']]\n",
    "    modes2 = [min(m, max_modes) for m in config['model']['modes2']]\n",
    "    if modes1 != config['model']['modes1']:\n",
    "        print(f\"    ↳ modes capped to {modes1} (Nx={Nx} supports max {max_modes})\")\n",
    "    return FNN2d(\n",
    "        modes1=modes1, modes2=modes2,\n",
    "        fc_dim=config['model']['fc_dim'],\n",
    "        layers=config['model']['layers'],\n",
    "        activation=config['model']['activation'],\n",
    "    ).to(device)\n",
    "\n",
    "\n",
    "# ── 3. Training loop ──────────────────────────────────────────────────────────\n",
    "\n",
    "def train_ablation(model, train_loader_data, train_loader_pde,\n",
    "                   optimizer, scheduler, config, device,\n",
    "                   use_data_loss=True, epochs=None,\n",
    "                   log_training=False, val_freq=50,\n",
    "                   val_loader=None):\n",
    "    \"\"\"\n",
    "    Returns a history dict:\n",
    "      {\n",
    "        'epoch':       [0, 1, ...],\n",
    "        'total':       [...],   # unweighted: data_w*L_data + pde_w*L_pde + ic_w*L_ic\n",
    "        'data':        [...],   # unweighted L_data (0 if use_data_loss=False)\n",
    "        'pde':         [...],   # unweighted L_pde\n",
    "        'ic':          [...],   # unweighted L_ic\n",
    "        'val_epoch':   [...],   # epochs at which validation ran\n",
    "        'val_l2':      [...],   # validation rel-L2 at those epochs\n",
    "      }\n",
    "    Always returned; empty lists if log_training=False.\n",
    "    \"\"\"\n",
    "    data_weight = config['train']['xy_loss'] if use_data_loss else 0.0\n",
    "    f_weight    = config['train']['f_loss']\n",
    "    ic_weight   = config['train']['ic_loss']\n",
    "    c_val       = config['data']['c']\n",
    "    n_epochs    = epochs if epochs is not None else config['train']['epochs']\n",
    "    myloss      = LpLoss(size_average=True)\n",
    "\n",
    "    history = dict(epoch=[], total=[], data=[], pde=[], ic=[],\n",
    "                   val_epoch=[], val_l2=[])\n",
    "\n",
    "    def cycle(loader):\n",
    "        while True:\n",
    "            for batch in loader:\n",
    "                yield batch\n",
    "\n",
    "    pde_iter = cycle(train_loader_pde)\n",
    "\n",
    "    pbar = tqdm(range(n_epochs), dynamic_ncols=True, smoothing=0.1)\n",
    "    for e in pbar:\n",
    "        model.train()\n",
    "        sum_data, sum_pde, sum_ic, sum_total = 0., 0., 0., 0.\n",
    "\n",
    "        for x_lo, y_lo in train_loader_data:\n",
    "            x_lo = x_lo.to(device)\n",
    "            y_lo = y_lo.to(device)\n",
    "\n",
    "            if use_data_loss:\n",
    "                # Safety check for coarse training data\n",
    "                if x_lo.size(1) < 32 or x_lo.size(2) < 32:\n",
    "                    x_in = x_lo.permute(0, 3, 1, 2)\n",
    "                    x_in = torch.nn.functional.interpolate(x_in, size=(64, 64), mode='bilinear', align_corners=True)\n",
    "                    x_in = x_in.permute(0, 2, 3, 1)\n",
    "                    out_lo = model(x_in).reshape(x_in.shape[0], 64, 64)\n",
    "                    out_lo = torch.nn.functional.interpolate(out_lo.unsqueeze(1), size=y_lo.shape[1:], \n",
    "                                                             mode='bilinear', align_corners=True).squeeze(1)\n",
    "                else:\n",
    "                    out_lo = model(x_lo).reshape(y_lo.shape)\n",
    "                \n",
    "                data_loss = myloss(out_lo, y_lo)\n",
    "            else:\n",
    "                data_loss = torch.tensor(0.0, device=device)\n",
    "\n",
    "            x_hi, _ = next(pde_iter)\n",
    "            x_hi    = x_hi.to(device)\n",
    "            out_hi  = model(x_hi).reshape(x_hi.shape[0], x_hi.shape[1], x_hi.shape[2])\n",
    "            loss_ic_hi, loss_f_hi = PINO_loss_wave(out_hi, x_hi[:, 0, :, 0], c=c_val)\n",
    "\n",
    "            total_loss = (data_loss   * data_weight\n",
    "                        + loss_ic_hi * ic_weight\n",
    "                        + loss_f_hi  * f_weight)\n",
    "\n",
    "            optimizer.zero_grad()\n",
    "            total_loss.backward()\n",
    "            optimizer.step()\n",
    "\n",
    "            del out_hi, x_hi\n",
    "\n",
    "            sum_data  += data_loss.item()\n",
    "            sum_pde   += loss_f_hi.item()\n",
    "            sum_ic    += loss_ic_hi.item()\n",
    "            sum_total += total_loss.item()\n",
    "\n",
    "            del loss_ic_hi, loss_f_hi\n",
    "\n",
    "        n = len(train_loader_data)\n",
    "        scheduler.step()\n",
    "\n",
    "        if log_training:\n",
    "            history['epoch'].append(e)\n",
    "            history['total'].append(sum_total / n)\n",
    "            history['data'].append(sum_data  / n)\n",
    "            history['pde'].append(sum_pde    / n)\n",
    "            history['ic'].append(sum_ic      / n)\n",
    "\n",
    "            # Periodic validation\n",
    "            if val_loader is not None and (e + 1) % val_freq == 0:\n",
    "                model.eval()\n",
    "                v_l2 = []\n",
    "                with torch.no_grad():\n",
    "                    for xv, yv in val_loader:\n",
    "                        xv = xv.to(device)\n",
    "                        yv = yv.to(device)\n",
    "                        \n",
    "                        # SAFETY INTERPOLATION\n",
    "                        if xv.size(1) < 32 or xv.size(2) < 32:\n",
    "                            x_in = xv.permute(0, 3, 1, 2)\n",
    "                            x_in = torch.nn.functional.interpolate(x_in, size=(64, 64), mode='bilinear', align_corners=True)\n",
    "                            x_in = x_in.permute(0, 2, 3, 1)\n",
    "                            ov = model(x_in).reshape(x_in.shape[0], 64, 64)\n",
    "                            ov = torch.nn.functional.interpolate(ov.unsqueeze(1), size=yv.shape[1:], mode='bilinear').squeeze(1)\n",
    "                        else:\n",
    "                            ov = model(xv).reshape(yv.shape)\n",
    "                            \n",
    "                        v_l2.append(myloss(ov, yv).item())\n",
    "                history['val_epoch'].append(e)\n",
    "                history['val_l2'].append(float(np.mean(v_l2)))\n",
    "                model.train()\n",
    "\n",
    "        data_str = f'data={sum_data/n:.4f}' if use_data_loss else 'data=OFF'\n",
    "        pbar.set_description(\n",
    "            f'Ep {e:>3}  total={sum_total/n:.4f}  '\n",
    "            f'pde={sum_pde/n:.5f}  {data_str}'\n",
    "        )\n",
    "\n",
    "    print('Training complete.')\n",
    "    return history\n",
    "\n",
    "\n",
    "# ── 4. Physics residual helper ────────────────────────────────────────────────\n",
    "\n",
    "def compute_normalized_physics_residual(out, c_val):\n",
    "    Du  = FDM_Wave(out, D=1.0, c=c_val)\n",
    "    nt  = out.size(1)\n",
    "    dt  = 1.0 / (nt - 1)\n",
    "    utt = (out[:, 2:, :] - 2.0 * out[:, 1:-1, :] + out[:, :-2, :]) / dt ** 2\n",
    "    rms_res = Du.pow(2).mean().sqrt()\n",
    "    rms_utt = utt.pow(2).mean().sqrt().clamp(min=1e-8)\n",
    "    return (rms_res / rms_utt).item()\n",
    "\n",
    "\n",
    "# ── 5. Loss curve plot helper ─────────────────────────────────────────────────\n",
    "\n",
    "def plot_loss_curves(history_main, history_base=None,\n",
    "                     run_label='', save_dir='', fname='loss.png'):\n",
    "    \"\"\"\n",
    "    Plot unweighted data / PDE / IC / total loss per epoch.\n",
    "    If history_base is provided (paired baseline), overlay it with dashed lines.\n",
    "    Validation L2 goes on a secondary y-axis if present.\n",
    "    \"\"\"\n",
    "    epochs = history_main['epoch']\n",
    "    if not epochs:\n",
    "        return   # logging was off\n",
    "\n",
    "    fig, ax1 = plt.subplots(figsize=(10, 4))\n",
    "    ax2 = ax1.twinx()\n",
    "\n",
    "    def _plot(hist, suffix='', ls='-'):\n",
    "        ep = hist['epoch']\n",
    "        if any(v > 0 for v in hist['data']):\n",
    "            ax1.plot(ep, hist['data'],  color='tab:blue',   ls=ls, lw=1.5,\n",
    "                     label=f'Data loss{suffix}')\n",
    "        ax1.plot(ep, hist['pde'],   color='tab:orange',  ls=ls, lw=1.5,\n",
    "                 label=f'PDE loss{suffix}')\n",
    "        ax1.plot(ep, hist['ic'],    color='tab:green',   ls=ls, lw=1.5,\n",
    "                 label=f'IC loss{suffix}')\n",
    "        ax1.plot(ep, hist['total'], color='black',       ls=ls, lw=2,\n",
    "                 label=f'Total loss{suffix}')\n",
    "        if hist['val_epoch']:\n",
    "            ax2.plot(hist['val_epoch'], [v * 100 for v in hist['val_l2']],\n",
    "                     color='tab:red', ls=ls, lw=1.5, marker='o', markersize=5,\n",
    "                     label=f'Val L2 %{suffix}')\n",
    "\n",
    "    _plot(history_main, suffix=' (data+PDE)' if history_base else '')\n",
    "    if history_base:\n",
    "        _plot(history_base, suffix=' (PDE only)', ls='--')\n",
    "\n",
    "    ax1.set_xlabel('Epoch')\n",
    "    ax1.set_ylabel('Loss (unweighted)')\n",
    "    ax1.set_yscale('log')\n",
    "    ax1.legend(loc='upper left', fontsize=8)\n",
    "    ax1.grid(True, alpha=0.2)\n",
    "\n",
    "    if history_main['val_epoch'] or (history_base and history_base['val_epoch']):\n",
    "        ax2.set_ylabel('Validation rel. $L^2$ error (%)', color='tab:red')\n",
    "        ax2.tick_params(axis='y', labelcolor='tab:red')\n",
    "        ax2.legend(loc='upper right', fontsize=8)\n",
    "\n",
    "    plt.title(f'Training loss curves — {run_label}')\n",
    "    plt.tight_layout()\n",
    "    fpath = os.path.join(save_dir, fname)\n",
    "    plt.savefig(fpath, dpi=150, bbox_inches='tight')\n",
    "    plt.show()\n",
    "    print(f\"  Loss curve saved: {fpath}\")\n",
    "\n",
    "\n",
    "# ── 6. Per-run resolution plot helper ────────────────────────────────────────\n",
    "\n",
    "def plot_run(run_label, Nx_data_run, Nx_pde_run, res_arr,\n",
    "             res_arr_base=None, save_dir='', fname='run.png'):\n",
    "    \"\"\"\n",
    "    Per-run resolution plot.  If res_arr_base is provided (matched PDE-only\n",
    "    baseline), its lines are overlaid in dashed style.\n",
    "    \"\"\"\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n",
    "\n",
    "    def _add_lines(ax, Nx_v, y_v, is_phys, ls='-', label_suffix=''):\n",
    "        mk = 's' if is_phys else 'o'\n",
    "        color = 'tab:orange' if is_phys else 'tab:blue'\n",
    "        ax.plot(Nx_v, y_v, marker=mk, ls=ls, color=color,\n",
    "                linewidth=2, markersize=8,\n",
    "                label=('Data+PDE' if not label_suffix else label_suffix))\n",
    "\n",
    "    for ax_i, is_phys in enumerate([False, True]):\n",
    "        ax = axes[ax_i]\n",
    "        col = 2 if is_phys else 2   # l2_vals at col 2, phys at col 3\n",
    "        y_main = res_arr[:, 3] if is_phys else res_arr[:, 2] * 100\n",
    "        _add_lines(ax, res_arr[:, 0], y_main, is_phys,\n",
    "                   ls='-', label_suffix='Data+PDE')\n",
    "\n",
    "        if res_arr_base is not None:\n",
    "            y_base = res_arr_base[:, 3] if is_phys else res_arr_base[:, 2] * 100\n",
    "            _add_lines(ax, res_arr_base[:, 0], y_base, is_phys,\n",
    "                       ls='--', label_suffix='PDE only (matched)')\n",
    "\n",
    "        if Nx_data_run is not None:\n",
    "            ax.axvline(Nx_data_run, color='gray', ls='--', alpha=0.5,\n",
    "                       label=f'Data res. (Nx={Nx_data_run})')\n",
    "        ax.axvline(Nx_pde_run, color='salmon', ls=':', alpha=0.7,\n",
    "                   label=f'PDE res. (Nx={Nx_pde_run})')\n",
    "\n",
    "        ax.set_xscale('log', base=2)\n",
    "        ax.set_xticks(res_arr[:, 0])\n",
    "        ax.get_xaxis().set_major_formatter(plt.ScalarFormatter())\n",
    "        ax.set_xticklabels([f'{int(nx)}\\n({int(m)}×)'\n",
    "                            for nx, m in zip(res_arr[:, 0], res_arr[:, 1])])\n",
    "        ax.set_xlabel('Spatial resolution $N_x$ (× data training res)')\n",
    "        ax.grid(True, alpha=0.2)\n",
    "        ax.legend(fontsize=8)\n",
    "\n",
    "        if is_phys:\n",
    "            ax.set_yscale('log')\n",
    "            ax.set_ylabel('Normalized physics residual\\n'\n",
    "                          r'$\\mathrm{RMS}(u_{tt}-c^2u_{xx})/\\mathrm{RMS}(u_{tt})$')\n",
    "            ax.set_title('Physics residual vs. resolution')\n",
    "            ax.grid(True, alpha=0.2, which='both')\n",
    "        else:\n",
    "            ax.set_ylabel('Relative $L^2$ error (%)')\n",
    "            ax.set_title('Prediction error vs. resolution')\n",
    "\n",
    "    data_str = f'Nx={Nx_data_run}' if Nx_data_run is not None else 'No data'\n",
    "    plt.suptitle(\n",
    "        f'Resolution invariance — Wave 1D PINO\\n'\n",
    "        f'Data @ {data_str};  PDE loss @ Nx={Nx_pde_run} [{PDE_MULTIPLIER}×]',\n",
    "        y=1.03,\n",
    "    )\n",
    "    plt.tight_layout()\n",
    "    fpath = os.path.join(save_dir, fname)\n",
    "    plt.savefig(fpath, dpi=150, bbox_inches='tight')\n",
    "    plt.show()\n",
    "    print(f\"  Saved: {fpath}\")\n",
    "\n",
    "\n",
    "# ── 7. Train-or-load helper ───────────────────────────────────────────────────\n",
    "\n",
    "def train_or_load(ckpt_path, model, optimizer, scheduler,\n",
    "                  train_loader_data, train_loader_pde, val_loader,\n",
    "                  use_data_loss, config):\n",
    "    \"\"\"\n",
    "    If checkpoint exists, load and return empty history.\n",
    "    Otherwise train, save checkpoint, return history.\n",
    "    \"\"\"\n",
    "    if os.path.exists(ckpt_path):\n",
    "        print(f\"  Checkpoint found — skipping training: {ckpt_path}\")\n",
    "        load_checkpoint(model, ckpt_path, optimizer=optimizer)\n",
    "        model.to(EXPERIMENT_DEVICE)\n",
    "        return dict(epoch=[], total=[], data=[], pde=[], ic=[],\n",
    "                    val_epoch=[], val_l2=[])\n",
    "\n",
    "    history = train_ablation(\n",
    "        model, train_loader_data, train_loader_pde,\n",
    "        optimizer, scheduler, config,\n",
    "        device=EXPERIMENT_DEVICE,\n",
    "        use_data_loss=use_data_loss,\n",
    "        log_training=LOG_TRAINING,\n",
    "        val_freq=VAL_FREQ,\n",
    "        val_loader=val_loader if LOG_TRAINING else None,\n",
    "    )\n",
    "    save_checkpoint(config['train']['save_dir'],\n",
    "                    os.path.basename(ckpt_path), model, optimizer)\n",
    "    print(f\"  Saved: {ckpt_path}\")\n",
    "    return history\n",
    "\n",
    "\n",
    "# ── 8. Eval sweep helper ──────────────────────────────────────────────────────\n",
    "\n",
    "def eval_sweep(model, Nx_ref_run, val_loader_map):\n",
    "    results = []\n",
    "    model.eval()\n",
    "    for mult in EVAL_MULTIPLIERS:\n",
    "        Nx_eval = Nx_ref_run * mult\n",
    "        if Nx_eval > N: continue\n",
    "        loader = val_loader_map.get(Nx_eval)\n",
    "        if loader is None: continue\n",
    "        \n",
    "        l2_list, ph_list = [], []\n",
    "        with torch.no_grad():\n",
    "            for x_ev, y_ev in loader:\n",
    "                x_ev = x_ev.to(EXPERIMENT_DEVICE)\n",
    "                y_ev = y_ev.to(EXPERIMENT_DEVICE)\n",
    "                \n",
    "                # --- SAFETY INTERPOLATION FOR COARSE EVAL ---\n",
    "                curr_nx, curr_nt = x_ev.size(1), x_ev.size(2)\n",
    "                # If resolution is lower than ~32, FNO with 15 modes will crash\n",
    "                if curr_nx < 32 or curr_nt < 32:\n",
    "                    x_in = x_ev.permute(0, 3, 1, 2)\n",
    "                    x_in = torch.nn.functional.interpolate(x_in, size=(64, 64), mode='bilinear', align_corners=True)\n",
    "                    x_in = x_in.permute(0, 2, 3, 1)\n",
    "                    \n",
    "                    out = model(x_in).reshape(x_in.shape[0], 64, 64)\n",
    "                    \n",
    "                    # Map back to original coarse resolution to compare with y_ev\n",
    "                    out = torch.nn.functional.interpolate(out.unsqueeze(1), size=(curr_nx, curr_nt), \n",
    "                                                          mode='bilinear', align_corners=True).squeeze(1)\n",
    "                else:\n",
    "                    out = model(x_ev).reshape(y_ev.shape)\n",
    "                # --------------------------------------------\n",
    "\n",
    "                l2_list.append(myloss(out, y_ev).item())\n",
    "                ph_list.append(compute_normalized_physics_residual(out, c))\n",
    "        \n",
    "        mean_l2, mean_ph = float(np.mean(l2_list)), float(np.mean(ph_list))\n",
    "        print(f\"    {mult:>2}× Nx={Nx_eval:>5}  L2={mean_l2*100:.4f}%  Phys={mean_ph:.6f}\")\n",
    "        results.append((Nx_eval, mult, mean_l2, mean_ph))\n",
    "    return np.array(results)\n",
    "\n",
    "\n",
    "# ── 9. Main loop ──────────────────────────────────────────────────────────────\n",
    "\n",
    "myloss      = LpLoss(size_average=True)\n",
    "all_results = {}   # label → (Nx_ref, Nx_pde, res_arr)\n",
    "# Separate store for matched PDE-only baselines: Nx_data → (Nx_pde, res_arr)\n",
    "baseline_results = {}\n",
    "\n",
    "for Nx_data in data_resolutions:\n",
    "    use_data   = Nx_data is not None\n",
    "    Nx_ref_run = Nx_data if use_data else Nx_ref\n",
    "\n",
    "    Nx_pde_run = min(N, Nx_ref_run * PDE_MULTIPLIER)\n",
    "    sub_x_pde  = N // Nx_pde_run\n",
    "    bs_pde     = max(1, config['train']['batchsize'] // PDE_MULTIPLIER)\n",
    "\n",
    "    run_label  = f'Nx={Nx_data}' if use_data else 'No data (PDE+IC only)'\n",
    "    ckpt_name  = (f'ablation-{PDE_MULTIPLIER}x-data{Nx_data}.pt'\n",
    "                  if use_data else f'ablation-{PDE_MULTIPLIER}x-datanone.pt')\n",
    "    ckpt_path  = os.path.join('checkpoints', config['train']['save_dir'], ckpt_name)\n",
    "\n",
    "    print(f\"\\n{'='*65}\")\n",
    "    print(f\"  Run : {run_label}\")\n",
    "    print(f\"  PDE : Nx={Nx_pde_run}  (sub_x={sub_x_pde}, batch={bs_pde})\")\n",
    "    print(f\"{'='*65}\")\n",
    "\n",
    "    # ── Build eval loaders for this run (shared between main + baseline) ──────\n",
    "    eval_loader_map = {}\n",
    "    for mult in EVAL_MULTIPLIERS:\n",
    "        Nx_eval = Nx_ref_run * mult\n",
    "        if Nx_eval > N:\n",
    "            continue\n",
    "        sub_x_ev = N // Nx_eval\n",
    "        ds_ev    = DataLoader1D(a, u, nx=N, nt=Nt0,\n",
    "                                sub=sub_x_ev, sub_t=sub_t_data)\n",
    "        eval_loader_map[Nx_eval] = ds_ev.make_loader(\n",
    "            n_test, bs_test, start=n_train, train=False)\n",
    "\n",
    "    # Val loader at data resolution (for training-time validation curve)\n",
    "    sub_x_val   = N // Nx_ref_run\n",
    "    ds_val      = DataLoader1D(a, u, nx=N, nt=Nt0,\n",
    "                               sub=sub_x_val, sub_t=sub_t_data)\n",
    "    val_loader  = ds_val.make_loader(n_test, bs_test,\n",
    "                                     start=n_train, train=False)\n",
    "\n",
    "    # ── PDE loader ────────────────────────────────────────────────────────────\n",
    "    ds_pde_run       = DataLoader1D(a, u, nx=N, nt=Nt0,\n",
    "                                    sub=sub_x_pde, sub_t=sub_t_data)\n",
