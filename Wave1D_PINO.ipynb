    "def FDM_Wave_normalized(u, D=1.0, c=1.0, sub_x_train=None, N_full=None):\n",
    "    \"\"\"\n",
    "    Normalized wave-equation residual: mean|u_tt - c²·u_xx| / mean|u_tt|.\n",
    "\n",
    "    Caps spectral wavenumbers at the TRAINING bandwidth so that\n",
    "    super-resolution Fourier modes (which the model was never trained on)\n",
    "    don't artificially inflate the residual at higher eval resolutions.\n",
    "\n",
    "    Returns a dimensionless scalar comparable across resolutions.\n",
    "    \"\"\"\n",
    "    batchsize = u.size(0)\n",
    "    nt = u.size(1)\n",
    "    nx = u.size(2)\n",
    "    dt = D / (nt - 1)\n",
    "\n",
    "    # Cap at training k_max so high-res eval is fair\n",
    "    k_max_train = (N_full // sub_x_train) // 2\n",
    "    k_max       = min(nx // 2, k_max_train)\n",
    "\n",
    "    # Spectral second derivative in x (filtered to training bandwidth)\n",
    "    u_h = torch.fft.fft(u, dim=2)\n",
    "    mask = torch.zeros(nx, device=u.device)\n",
    "    mask[:k_max]         = 1.0\n",
    "    mask[nx - k_max:]    = 1.0\n",
    "    u_h_filtered = u_h * mask.reshape(1, 1, nx)\n",
    "\n",
    "    k_full = torch.cat([\n",
    "        torch.arange(0,       nx // 2, device=u.device),\n",
    "        torch.arange(-nx // 2, 0,      device=u.device),\n",
    "    ], dim=0).reshape(1, 1, nx)\n",
    "    uxx_h = -(2 * np.pi * k_full) ** 2 * u_h_filtered\n",
    "    uxx   = torch.fft.irfft(uxx_h[:, :, :nx // 2 + 1], dim=2, n=nx)\n",
    "\n",
    "    # Finite-difference second derivative in t\n",
    "    utt          = (u[:, 2:, :] - 2.0 * u[:, 1:-1, :] + u[:, :-2, :]) / dt ** 2\n",
    "    uxx_interior = uxx[:, 1:-1, :]\n",
    "\n",
    "    residual = utt - c ** 2 * uxx_interior\n",
    "\n",
    "    norm_utt = utt.abs().mean().clamp(min=1e-8)\n",
