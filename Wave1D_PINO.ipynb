    "# =============================================================================\n",
    "# PINO Wave 1D — Data Resolution Ablation\n",
    "# -----------------------------------------------------------------------------\n",
    "# Question: how coarse can training data be while still exhibiting zero-shot\n",
    "# super-resolution up to the PDE training resolution (Nx=2048)?\n",
    "#\n",
    "# Experiment:\n",
    "#   - PDE loss resolution: fixed at Nx=2048 for all runs\n",
    "#   - Data training resolutions swept: [128, 64, 32, 16, 8, 4, None]\n",
    "#     where None = zero xy_loss weight (pure PDE + IC, no data at all)\n",
    "#   - Eval sweep: always up to Nx=2048 (fixed ceiling), x-axis labeled as\n",
    "#     both absolute Nx and as multiplier of that run's data training res\n",
    "#   - Each resolution is checkpointed before training so partial runs are\n",
    "#     resumable — if a checkpoint exists, training is skipped for that entry\n",
    "#\n",
    "# Expected finding: at some coarseness the data loss stops contributing\n",
    "# anything meaningful and performance collapses to the PDE-only baseline.\n",
    "# =============================================================================\n",
    "\n",
    "import os\n",
    "import numpy as np\n",
    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.cm as cm\n",
    "from tqdm import tqdm\n",
    "from train_utils.losses import LpLoss\n",
    "from train_utils.datasets import DataLoader1D\n",
    "from train_utils.utils import save_checkpoint, load_checkpoint\n",
    "\n",
    "# ── 0. Device ─────────────────────────────────────────────────────────────────\n",
    "\n",
    "EXPERIMENT_DEVICE = torch.device('cuda:0')   # ← adjust as needed\n",
    "torch.cuda.empty_cache()\n",
    "print(f\"Running on: {EXPERIMENT_DEVICE}\")\n",
    "print(f\"  Free VRAM: {torch.cuda.mem_get_info(EXPERIMENT_DEVICE)[0] / 1e9:.2f} GB\")\n",
    "\n",
    "\n",
    "# ── 1. Experiment config ──────────────────────────────────────────────────────\n",
    "\n",
    "sub_t_data = config['data']['sub_t']\n",
    "c          = config['data']['c']\n",
    "n_train    = config['data']['n_train']\n",
    "n_test     = config['data']['n_test']\n",
    "bs_test    = config['test']['batchsize']\n",
    "\n",
    "# Fixed PDE resolution for all runs\n",
    "Nx_pde    = 2048\n",
    "sub_x_pde = N // Nx_pde   # e.g. 4096 // 2048 = 2\n",
    "\n",
    "# Data training resolutions to sweep (None = no data loss)\n",
    "data_resolutions = [128, 64, 32, 16, 8, 4, None]\n",
    "\n",
    "# Eval resolutions: always the same fixed set up to Nx_pde\n",
    "eval_Nx_list = [nx for nx in [128, 256, 512, 1024, 2048]\n",
    "                if nx <= Nx_pde]\n",
    "\n",
    "# PDE batch size: scaled to keep VRAM flat at Nx=2048\n",
    "# At bs_data=20 and Nx_pde=2048 = 16× Nx_data=128 → bs_pde = 20//16 = 1\n",
    "# Manually set to 2 if VRAM allows (less gradient noise)\n",
    "bs_data_default = config['train']['batchsize']\n",
    "bs_pde          = 2   # safe at Nx=2048 with ~4.5 GB free; set to 1 if OOM\n",
    "\n",
    "print(f\"\\nFixed PDE resolution : Nx={Nx_pde}  (sub_x={sub_x_pde}, batch={bs_pde})\")\n",
    "print(f\"Data resolutions     : {data_resolutions}\")\n",
    "print(f\"Eval Nx ceiling      : {eval_Nx_list}\")\n",
    "print(f\"Resumable            : yes — skips if checkpoint exists\")\n",
    "\n",
    "\n",
    "# ── 2. Training loop ──────────────────────────────────────────────────────────\n",
    "\n",
    "def train_ablation(model, train_loader_data, train_loader_pde,\n",
    "                   optimizer, scheduler, config, device,\n",
    "                   use_data_loss=True, epochs=None):\n",
    "    \"\"\"\n",
    "    Train PINO for one data-resolution condition.\n",
    "\n",
    "    use_data_loss=False → zero xy_loss weight (pure PDE + IC).\n",
    "    train_loader_data is still passed for uniform code structure but its\n",
    "    iterations just drive the loop count; the data loss term is zeroed.\n",
    "    \"\"\"\n",
    "    data_weight = config['train']['xy_loss'] if use_data_loss else 0.0\n",
    "    f_weight    = config['train']['f_loss']\n",
    "    ic_weight   = config['train']['ic_loss']\n",
    "    c_val       = config['data']['c']\n",
    "    n_epochs    = epochs if epochs is not None else config['train']['epochs']\n",
    "    myloss      = LpLoss(size_average=True)\n",
    "\n",
    "    def cycle(loader):\n",
    "        while True:\n",
    "            for batch in loader:\n",
    "                yield batch\n",
    "\n",
    "    pde_iter = cycle(train_loader_pde)\n",
    "\n",
    "    pbar = tqdm(range(n_epochs), dynamic_ncols=True, smoothing=0.1)\n",
    "    for e in pbar:\n",
    "        model.train()\n",
    "        sum_data, sum_total = 0.0, 0.0\n",
    "\n",
    "        for x_lo, y_lo in train_loader_data:\n",
    "            x_lo = x_lo.to(device)\n",
    "            y_lo = y_lo.to(device)\n",
    "\n",
    "            # (a) Data loss — zeroed if use_data_loss=False\n",
    "            if use_data_loss:\n",
    "                # We must ensure BOTH Nx and Nt are large enough for the model modes\n",
    "                # modes1 usually corresponds to x, modes2 to y/t\n",
    "                min_h = 64 \n",
    "                min_w = 64 # Or whatever is > 2 * modes2\n",
    "                \n",
    "                curr_h, curr_w = x_lo.size(1), x_lo.size(2)\n",
    "\n",
    "                if curr_h < min_h or curr_w < min_w:\n",
    "                    # Interpolate to a safe resolution for the FNO layers\n",
    "                    x_lo_input = x_lo.permute(0, 3, 1, 2) # [B, C, H, W]\n",
    "                    x_lo_input = torch.nn.functional.interpolate(\n",
    "                        x_lo_input, size=(min_h, min_w), mode='bilinear', align_corners=True\n",
    "                    )\n",
    "                    x_lo_input = x_lo_input.permute(0, 2, 3, 1) # [B, H, W, C]\n",
    "                else:\n",
    "                    x_lo_input = x_lo\n",
    "\n",
    "                # Forward pass\n",
    "                out_lo_full = model(x_lo_input) \n",
    "                # model output is [B, H_new, W_new, 1], we want [B, H_new, W_new]\n",
    "                out_lo = out_lo_full.reshape(out_lo_full.shape[0], out_lo_full.shape[1], out_lo_full.shape[2])\n",
    "                \n",
    "                # If we interpolated UP, we must interpolate the prediction DOWN to match y_lo\n",
    "                if curr_h < min_h or curr_w < min_w:\n",
    "                    # out_lo is [B, H_new, W_new], add channel dim for interpolate: [B, 1, H_new, W_new]\n",
    "                    out_lo = torch.nn.functional.interpolate(\n",
    "                        out_lo.unsqueeze(1), size=(curr_h, curr_w), mode='bilinear', align_corners=True\n",
    "                    ).squeeze(1)\n",
    "\n",
    "                data_loss = myloss(out_lo, y_lo)\n",
    "\n",
    "            # (b) PDE + IC loss at high resolution\n",
    "            x_hi, _ = next(pde_iter)\n",
    "            x_hi    = x_hi.to(device)\n",
    "            out_hi  = model(x_hi).reshape(x_hi.shape[0], x_hi.shape[1], x_hi.shape[2])\n",
    "\n",
    "            loss_ic_hi, loss_f_hi = PINO_loss_wave(out_hi, x_hi[:, 0, :, 0], c=c_val)\n",
    "\n",
    "            total_loss = (data_loss   * data_weight\n",
    "                        + loss_ic_hi * ic_weight\n",
    "                        + loss_f_hi  * f_weight)\n",
    "\n",
    "            optimizer.zero_grad()\n",
    "            total_loss.backward()\n",
    "            optimizer.step()\n",
    "\n",
    "            del out_hi, x_hi, loss_ic_hi, loss_f_hi\n",
    "\n",
    "            sum_data  += data_loss.item()\n",
    "            sum_total += total_loss.item()\n",
    "\n",
    "        n = len(train_loader_data)\n",
    "        scheduler.step()\n",
    "        data_str = f'data={sum_data/n:.4f}' if use_data_loss else 'data=OFF'\n",
    "        pbar.set_description(\n",
    "            f'Ep {e:>3}  total={sum_total/n:.4f}  {data_str}'\n",
    "        )\n",
    "\n",
    "    print('Training complete.')\n",
    "\n",
    "\n",
    "# ── 3. Physics residual helper ────────────────────────────────────────────────\n",
    "\n",
    "def compute_normalized_physics_residual(out, c_val):\n",
    "    \"\"\"RMS(u_tt - c²·u_xx) / RMS(u_tt) — dimensionless, resolution-comparable.\"\"\"\n",
    "    Du  = FDM_Wave(out, D=1.0, c=c_val)\n",
    "    nt  = out.size(1)\n",
    "    dt  = 1.0 / (nt - 1)\n",
    "    utt = (out[:, 2:, :] - 2.0 * out[:, 1:-1, :] + out[:, :-2, :]) / dt ** 2\n",
    "    rms_res = Du.pow(2).mean().sqrt()\n",
    "    rms_utt = utt.pow(2).mean().sqrt().clamp(min=1e-8)\n",
    "    return (rms_res / rms_utt).item()\n",
    "\n",
    "\n",
    "# ── 4. Main loop: train + evaluate each data resolution ───────────────────────\n",
    "\n",
    "# PDE loader is shared across all runs (resolution never changes)\n",
    "ds_pde           = DataLoader1D(a, u, nx=N, nt=Nt0, sub=sub_x_pde, sub_t=sub_t_data)\n",
    "train_loader_pde = ds_pde.make_loader(n_train, bs_pde, start=0, train=True)\n",
    "\n",
    "min_nx = 2 * max(config['model']['modes2'])\n",
    "\n",
    "# all_results[label] = np.array of (Nx_eval, mult_of_data_res, rel_L2, norm_phys)\n",
    "all_results = {}\n",
    "myloss      = LpLoss(size_average=True)\n",
    "\n",
    "for Nx_data in data_resolutions:\n",
    "    use_data  = Nx_data is not None\n",
    "    run_label = f'Nx={Nx_data}' if use_data else 'No data (PDE+IC only)'\n",
    "    ckpt_name = f'Wave-ablation-data{Nx_data if use_data else \"none\"}.pt'\n",
    "    ckpt_path = os.path.join('checkpoints', config['train']['save_dir'], ckpt_name)\n",
    "\n",
    "    print(f\"\\n{'='*65}\")\n",
    "    print(f\"  Run: {run_label}  |  PDE @ Nx={Nx_pde}\")\n",
    "    print(f\"{'='*65}\")\n",
    "\n",
    "    # ── 4a. Build or load model ───────────────────────────────────────────────\n",
    "    model_run = FNN2d(\n",
    "        modes1=config['model']['modes1'],\n",
    "        modes2=config['model']['modes2'],\n",
    "        fc_dim=config['model']['fc_dim'],\n",
    "        layers=config['model']['layers'],\n",
    "        activation=config['model']['activation'],\n",
    "    ).to(EXPERIMENT_DEVICE)\n",
    "\n",
    "    optimizer_run = Adam(model_run.parameters(), betas=(0.9, 0.999),\n",
    "                         lr=config['train']['base_lr'])\n",
    "    scheduler_run = torch.optim.lr_scheduler.MultiStepLR(\n",
    "        optimizer_run,\n",
    "        milestones=config['train']['milestones'],\n",
    "        gamma=config['train']['scheduler_gamma'],\n",
    "    )\n",
    "\n",
    "    if os.path.exists(ckpt_path):\n",
    "        print(f\"  Checkpoint found — skipping training: {ckpt_path}\")\n",
    "        load_checkpoint(model_run, ckpt_path, optimizer=optimizer_run)\n",
    "        model_run = model_run.to(EXPERIMENT_DEVICE)\n",
    "    else:\n",
    "        # Data loader: if no data loss, use a dummy low-res loader just to\n",
    "        # drive the iteration count (its output is ignored in the loss)\n",
    "        sub_x_data_run = N // Nx_data if use_data else N // 128\n",
    "        bs_run         = config['train']['batchsize'] if use_data else 4\n",
    "\n",
    "        ds_data_run  = DataLoader1D(a, u, nx=N, nt=Nt0,\n",
    "                                    sub=sub_x_data_run, sub_t=sub_t_data)\n",
    "        train_loader_run = ds_data_run.make_loader(n_train, bs_run,\n",
    "                                                   start=0, train=True)\n",
    "\n",
    "        print(f\"  Training  (data batch={bs_run if use_data else 'N/A (zeroed)'},  \"\n",
    "              f\"PDE batch={bs_pde}) ...\")\n",
    "\n",
    "        train_ablation(\n",
    "            model_run, train_loader_run, train_loader_pde,\n",
    "            optimizer_run, scheduler_run, config,\n",
    "            device=EXPERIMENT_DEVICE,\n",
    "            use_data_loss=use_data,\n",
    "        )\n",
    "\n",
    "        save_checkpoint(config['train']['save_dir'], ckpt_name,\n",
    "                        model_run, optimizer_run)\n",
    "        print(f\"  Saved: {ckpt_path}\")\n",
    "\n",
    "    # ── 4b. Evaluation sweep ──────────────────────────────────────────────────\n",
    "    print(f\"\\n  Evaluating at Nx = {eval_Nx_list} ...\")\n",
    "    run_results = []\n",
    "    model_run.eval()\n",
    "\n",
    "    for Nx_eval in eval_Nx_list:\n",
    "        if Nx_eval < min_nx:\n",
    "            print(f\"    Skipping Nx={Nx_eval} (< 2×modes={min_nx})\")\n",
    "            continue\n",
    "\n",
    "        sub_x_eval = N // Nx_eval\n",
    "        mult       = Nx_eval / Nx_data if use_data else float('nan')\n",
    "\n",
    "        ds_ev     = DataLoader1D(a, u, nx=N, nt=Nt0,\n",
    "                                 sub=sub_x_eval, sub_t=sub_t_data)\n",
    "        loader_ev = ds_ev.make_loader(n_test, bs_test,\n",
    "                                      start=n_train, train=False)\n",
    "\n",
    "        l2_list, phys_list = [], []\n",
    "        with torch.no_grad():\n",
    "            for x_ev, y_ev in loader_ev:\n",
    "                x_ev = x_ev.to(EXPERIMENT_DEVICE)\n",
    "                y_ev = y_ev.to(EXPERIMENT_DEVICE)\n",
    "                out_ev = model_run(x_ev).reshape(y_ev.shape)\n",
    "                l2_list.append(myloss(out_ev, y_ev).item())\n",
    "                phys_list.append(compute_normalized_physics_residual(out_ev, c))\n",
    "\n",
    "        mean_l2   = float(np.mean(l2_list))\n",
    "        mean_phys = float(np.mean(phys_list))\n",
    "        mult_str  = f'{mult:.0f}×' if use_data else 'N/A'\n",
    "        print(f\"    Nx={Nx_eval:>5} ({mult_str:>5} data res) — \"\n",
    "              f\"L2={mean_l2*100:.4f}%  Phys={mean_phys:.6f}\")\n",
    "        run_results.append((Nx_eval, mult, mean_l2, mean_phys))\n",
    "\n",
    "    all_results[run_label] = np.array(run_results)\n",
    "    del model_run\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "\n",
    "# ── 5. Plot ───────────────────────────────────────────────────────────────────\n",
    "\n",
    "%matplotlib inline\n",
    "\n",
    "# Color map: one color per data resolution condition\n",
    "labels  = list(all_results.keys())\n",
    "colors  = cm.viridis(np.linspace(0.1, 0.9, len(labels)))\n",
    "# No-data condition gets a distinct style\n",
    "no_data_label = 'No data (PDE+IC only)'\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "for (label, res_arr), color in zip(all_results.items(), colors):\n",
    "    Nx_vals   = res_arr[:, 0]\n",
    "    l2_vals   = res_arr[:, 2]\n",
    "    phys_vals = res_arr[:, 3]\n",
    "    is_no_data = (label == no_data_label)\n",
    "\n",
    "    ls = '--' if is_no_data else '-'\n",
    "    mk = 'x' if is_no_data else 'o'\n",
    "\n",
    "    axes[0].plot(Nx_vals, l2_vals * 100, marker=mk, ls=ls,\n",
    "                 color=color, linewidth=2, markersize=8, label=label)\n",
    "    axes[1].plot(Nx_vals, phys_vals, marker=mk, ls=ls,\n",
    "                 color=color, linewidth=2, markersize=8, label=label)\n",
    "\n",
    "for ax in axes:\n",
    "    ax.axvline(Nx_pde, color='salmon', ls=':', alpha=0.8,\n",
    "               label=f'PDE loss res. (Nx={Nx_pde})')\n",
    "    ax.set_xscale('log', base=2)\n",
    "    ax.set_xticks(eval_Nx_list)\n",
    "    ax.get_xaxis().set_major_formatter(plt.ScalarFormatter())\n",
    "    # Bottom x-axis: absolute Nx; add secondary label showing mult for Nx_data=128 baseline\n",
    "    ax.set_xticklabels([f'{int(nx)}' for nx in eval_Nx_list])\n",
    "    ax.set_xlabel('Spatial resolution $N_x$')\n",
    "    ax.grid(True, alpha=0.2)\n",
    "    ax.legend(fontsize=8, loc='upper left')\n",
    "\n",
    "axes[0].set_ylabel('Relative $L^2$ error (%)')\n",
    "axes[0].set_title('Prediction error vs. resolution')\n",
    "\n",
    "axes[1].set_yscale('log')\n",
    "axes[1].set_ylabel('Normalized physics residual\\n'\n",
    "                   r'$\\mathrm{RMS}(u_{tt} - c^2 u_{xx})\\;/\\;\\mathrm{RMS}(u_{tt})$')\n",
    "axes[1].set_title('Normalized physics residual vs. resolution')\n",
    "axes[1].grid(True, alpha=0.2, which='both')\n",
    "\n",
    "plt.suptitle(\n",
    "    f'Data resolution ablation — Wave 1D PINO\\n'\n",
    "    f'(PDE loss fixed @ Nx={Nx_pde}; data res swept over {data_resolutions})',\n",
    "    y=1.03,\n",
    ")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ── 6. Summary table ──────────────────────────────────────────────────────────\n",
    "\n",
    "print(f\"\\n{'='*80}\")\n",
    "print(f\"  {'Data res':>16}  {'Nx_eval':>8}  {'Mult':>6}  {'Rel L2 (%)':>12}  {'Norm phys':>12}\")\n",
    "print(f\"{'='*80}\")\n",
    "for label, res_arr in all_results.items():\n",
    "    print(f\"\\n  {label}\")\n",
    "    for nx_v, mult_v, l2_v, ph_v in res_arr:\n",
    "        use_data = not np.isnan(mult_v)\n",
    "        mult_str = f'{mult_v:.0f}×' if use_data else 'N/A'\n",
    "        pde_tag  = '  ← PDE res' if int(nx_v) == Nx_pde else ''\n",
    "        print(f\"  {'':>16}  {int(nx_v):>8}  {mult_str:>6}  \"\n",
    "              f\"{l2_v*100:>12.4f}%  {ph_v:>12.6f}{pde_tag}\")\n",
    "print(f\"\\n{'='*80}\")\n",
    "print(\n",
    "    f\"\\nInterpretation:\"\n",
    "    f\"\\n  Zero-shot super-resolution holds for a given data res if L2 and physics\"\n",
    "    f\"\\n  residual stay flat from Nx=data_res up to Nx={Nx_pde}.\"\n",
    "    f\"\\n  The 'No data' baseline shows what PDE+IC loss alone achieves — any data\"\n",
    "    f\"\\n  resolution that matches or beats this is contributing nothing meaningful.\"\n",
    ")"
   ]
  },
