    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# PART 4 — Monotonicity test: Jensen's inequality forces the direction\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "#\n",
    "# The LpLoss computes:\n",
    "#\n",
    "#   L2(Nx) = (1/N Σ_i  e_i²)^(1/2) / (1/N Σ_i  u_i²)^(1/2)\n",
    "#\n",
    "# When we halve the resolution (Nx → Nx/2) by averaging adjacent pairs:\n",
    "#\n",
    "#   e_coarse[k] = (e_fine[2k] + e_fine[2k+1]) / 2\n",
    "#\n",
    "# Then by Jensen (f = x² is convex):\n",
    "#\n",
    "#   e_coarse[k]² = ((e[2k]+e[2k+1])/2)²  ≤  (e[2k]² + e[2k+1]²) / 2\n",
    "#\n",
    "# So  mean(e_coarse²)  ≤  mean(e_fine²)\n",
    "# → coarser grid always gives LOWER (or equal) numerator → lower L2\n",
    "# → refining always INCREASES L2 → strict monotone increase.\n",
    "#\n",
    "# The denominator (||u||) has the same structure so it also increases,\n",
    "# but the ERROR numerator grows faster because the error is concentrated\n",
    "# in high-frequency features that the coarse grid averages away.\n",
    "#\n",
    "# We verify this directly below.\n",
    "\n",
    "print(\"\\n\" + \"=\"*65)\n",
    "print(\"PART 4: Jensen's inequality monotonicity test\")\n",
    "print(\"=\"*65)\n",
    "print()\n",
    "print(\"For each consecutive pair of resolutions, we check:\")\n",
    "print(\"  mean(e_fine²)  ≥  mean(e_coarse_upsampled²)\")\n",
    "print(\"  where 'coarse upsampled' = coarse error broadcast to fine grid\")\n",
    "print()\n",
    "\n",
    "# Use the finest resolution as the reference frame.\n",
    "# Downsample the fine error to each coarser resolution by exact block-averaging,\n",
    "# then compare mean(e_fine²) vs mean(e_coarse_avg²) on the fine grid.\n",
    "\n",
    "finest_preds = finest['preds']   # (n_test, Nt, Nx_fine)\n",
    "finest_trues = finest['trues']\n",
    "e_fine       = finest_preds - finest_trues   # (n_test, Nt, Nx_fine)\n",
    "\n",
    "print(f\"{'Nx':>6}  {'mean(e_fine²)':>16}  {'mean(e_coarse_avg²)':>20}  \"\n",
    "      f\"{'Δ (fine-coarse)':>18}  {'Monotone ↑?':>12}\")\n",
    "print(\"-\"*78)\n",
    "\n",
    "for r in records[:-1]:   # all except the finest\n",
    "    Nx_c  = r['Nx']\n",
    "    ratio = Nx_fine // Nx_c   # exact power of 2\n",
    "\n",
    "    # Block-average the fine error to coarse resolution\n",
    "    e_fine_rs = e_fine.reshape(\n",
    "        e_fine.shape[0], e_fine.shape[1], Nx_c, ratio\n",
    "    )  # (n_test, Nt, Nx_c, ratio)\n",
    "    e_coarse_avg = e_fine_rs.mean(axis=-1)  # (n_test, Nt, Nx_c)\n",
    "\n",
    "    # Broadcast back to fine grid (nearest-neighbour, i.e. repeat)\n",
    "    # then compare squared means\n",
    "    mean_e2_fine   = (e_fine**2).mean()\n",
    "    mean_e2_coarse = (e_coarse_avg**2).mean() * ratio   # scaled to per-fine-point basis\n",
    "\n",
    "    delta   = mean_e2_fine - mean_e2_coarse\n",
    "    is_mono = \"YES ✓\" if delta > 0 else \"NO  ✗\"\n",
    "\n",
    "    print(f\"{Nx_c:>6}  {mean_e2_fine:>16.8f}  {mean_e2_coarse:>20.8f}  \"\n",
    "          f\"{delta:>18.2e}  {is_mono:>12}\")\n",
    "\n",
    "print()\n",
    "print(\"Interpretation:\")\n",
    "print(\"  Jensen: E[f(X)] ≥ f(E[X]) for convex f=x².\")\n",
    "print(\"  Coarser grid averages e before squaring → smaller mean square.\")\n",
    "print(\"  ⟹ Refining always increases discrete L2 numerator.\")\n",
    "print(\"  ⟹ Monotone INCREASE in L2 with resolution is not noise — it's forced.\")\n",
    "print()\n",
    "print(\"Why always same direction on repeated runs?\")\n",
    "print(\"  The model is FIXED (eval mode, no randomness). The only thing changing\")\n",
    "print(\"  is the sampling of the same smooth error field e(x,t). The direction\")\n",
    "print(\"  of Jensen's inequality is determined by the sign of the error field's\")\n",
    "print(\"  curvature, not by any stochastic process. So it's always monotone.\")\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# PART 5 — Simulated limit: what would happen with infinite resolution?\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "print(\"\\n\" + \"=\"*65)\n",
    "print(\"PART 5: Extrapolated limit (Richardson extrapolation)\")\n",
    "print(\"=\"*65)\n",
    "\n",
    "# Fit L(h) = L∞ + C * h^p where h = 1/Nx\n",
    "h_vals = 1.0 / Nx_vals\n",
    "# Fit on all points (log-log linear)\n",
    "valid = l2_vals > 0\n",
    "log_h = np.log(h_vals[valid])\n",
    "log_l = np.log(l2_vals[valid])\n",
    "p, log_C = np.polyfit(log_h, log_l, 1)\n",
    "C = np.exp(log_C)\n",
    "\n",
    "print(f\"\\n  Fitted convergence rate: L2(Nx) ≈ C / Nx^p\")\n",
    "print(f\"  p  = {p:.3f}  (1.0 = midpoint rule, 2.0 = trapezoidal)\")\n",
    "print(f\"  C  = {C:.6f}\")\n",
    "print(f\"\\n  Extrapolated limit (Nx→∞): L2 ≈ {C * (1/np.inf if np.inf > 0 else 0):.6f}%\")\n",
    "print(f\"  More practically, at Nx={Nx_fine*4}: \"\n",
    "      f\"L2 ≈ {C / (Nx_fine*4)**p * 100:.6f}%\")\n",
    "\n",
    "# Quick plot of the fit\n",
    "fig, ax = plt.subplots(figsize=(7, 4))\n",
    "ax.loglog(Nx_vals, l2_vals, 'o-', color='tab:blue', ms=8, lw=2, label='Observed')\n",
    "Nx_extrap = np.logspace(np.log2(Nx_vals[0]), np.log2(Nx_vals[-1]*4), 200, base=2)\n",
    "ax.loglog(Nx_extrap, C * (1/Nx_extrap)**p, 'k--', lw=1.5,\n",
    "          label=f'Fit: C / Nx^{p:.2f}')\n",
    "ax.set_xlabel('Nx')\n",
    "ax.set_ylabel('Relative L2 error')\n",
    "ax.set_title(f'Part 5: Convergence rate  (slope p={p:.2f})')\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.2, which='both')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nDone. Summary:\")\n",
    "print(f\"  The monotone increase in L2 as Nx grows is a mathematical certainty\")\n",
    "print(f\"  (Jensen's inequality on a fixed smooth error field), not a training\")\n",
    "print(f\"  artifact or noise. The direction (increasing) is because the coarse\")\n",
    "print(f\"  grid AVERAGES error before squaring, which always underestimates the\")\n",
    "print(f\"  true continuous norm. The convergence rate p≈{p:.1f} tells you how fast\")\n",
    "print(f\"  the discrete norm approaches the continuous integral.\")"
   ]
